# PostgreSQL 16+ com pgvector e pgcrypto
DATABASE_URL=postgresql://oss_kbdb:oss_kbdb@localhost:5432/oss_kbdb

# S3 standard / MinIO
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_ADDRESSING_STYLE=path

# local (SentenceTransformers) | openai_compatible
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSIONS=384
# Para endpoint OpenAI-compatible:
# EMBEDDING_BASE_URL=https://embedding.example/v1
# EMBEDDING_API_KEY=

# Chunking configurável
CHUNK_MAX_TOKENS=450
CHUNK_OVERLAP_TOKENS=60
CHUNK_MIN_TOKENS=30
FTS_LANGUAGE=portuguese

# deterministic (sem LLM) | openai_compatible (Ollama, vLLM, TGI etc.)
ENRICHMENT_PROVIDER=deterministic
ENRICHMENT_MODEL=deterministic-v1
# ENRICHMENT_BASE_URL=http://localhost:11434/v1
# ENRICHMENT_API_KEY=

# Para cada seed, retorna o pai e esta quantidade de filhos vizinhos de cada lado.
SEARCH_EXPANSION_SIBLINGS=1
